{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fonix.invalid/schemas/android-qnn-sdk-manifest-v1.json",
  "title": "Fonix application-supplied Android QNN SDK manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sdkId",
    "sdkVersion",
    "source",
    "backendId",
    "backendVersion",
    "license",
    "artifactsByAbi"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sdkId": { "$ref": "#/$defs/token" },
    "sdkVersion": { "$ref": "#/$defs/token" },
    "source": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
    "backendId": { "$ref": "#/$defs/token" },
    "backendVersion": { "$ref": "#/$defs/token" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "spdxId", "redistribution", "notice"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "spdxId": { "$ref": "#/$defs/token" },
        "redistribution": {
          "enum": ["prohibited", "restricted", "permitted"]
        },
        "notice": { "$ref": "#/$defs/fileIdentity" }
      }
    },
    "artifactsByAbi": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4,
      "propertyNames": { "$ref": "#/$defs/abi" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "path", "sizeBytes", "sha256", "licenseId"],
          "properties": {
            "role": { "$ref": "#/$defs/token" },
            "path": { "$ref": "#/$defs/path" },
            "sizeBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483648
            },
            "sha256": { "$ref": "#/$defs/sha256" },
            "licenseId": { "$ref": "#/$defs/token" }
          }
        }
      }
    }
  },
  "$defs": {
    "abi": {
      "enum": ["armeabi-v7a", "arm64-v8a", "x86", "x86_64"]
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$",
      "maxLength": 1024
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sizeBytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
