{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fonix.invalid/schemas/source-release-archive-validation-v1.json",
  "title": "Fonix source release archive closure validation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "result",
    "claimStatus",
    "purpose",
    "validationScope",
    "archive",
    "source",
    "tools",
    "schemas",
    "claimBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "result": { "const": "validated" },
    "claimStatus": { "const": "source-closure-only" },
    "purpose": { "const": "source-release-archive-closure-validation" },
    "validationScope": { "const": "offline-consistency-only" },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "mediaType", "sha256", "sizeBytes"],
      "properties": {
        "format": {
          "enum": ["git-archive-zip-v1", "git-archive-tar-gzip-v1"]
        },
        "mediaType": {
          "enum": ["application/zip", "application/gzip"]
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 603979776
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "revisionBinding",
        "manifestPath",
        "manifestSha256",
        "manifestSizeBytes",
        "manifestEntryCount",
        "memberCount",
        "regularFileCount",
        "directoryCount",
        "executableFileCount",
        "expandedBytes",
        "inventorySha256"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "revisionBinding": {
          "enum": ["zip-comment", "pax-global-comment"]
        },
        "manifestPath": { "const": "MANIFEST.sha256" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "manifestSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "manifestEntryCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "memberCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 65536
        },
        "regularFileCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16385
        },
        "directoryCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65534
        },
        "executableFileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "expandedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 541065216
        },
        "inventorySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator", "sourceManifestValidator"],
      "properties": {
        "validator": { "$ref": "#/$defs/fileIdentity" },
        "sourceManifestValidator": { "$ref": "#/$defs/fileIdentity" }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation"],
      "properties": {
        "validation": { "$ref": "#/$defs/fileIdentity" }
      }
    },
    "claimBoundary": {
      "const": "Offline source-closure validation only. It binds one archive's declared Git revision, closed member inventory, contents, manifest, and executable semantics to the current repository baseline; it does not authenticate archive origin, prove build reproducibility or target behavior, establish licensing, signing, or readiness, or authorize publication or distribution."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeBytes", "sha256"],
      "properties": {
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
