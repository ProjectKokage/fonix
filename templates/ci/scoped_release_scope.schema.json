{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fonix.invalid/schemas/scoped-release-scope-v1.json",
  "title": "Fonix scoped pre-1.0 release policy",
  "description": "A scope-only policy that classifies every locked baseline target without expressing readiness, approval, or publication authority.",
  "const": {
    "schemaVersion": 1,
    "policyId": "scoped-pre-1.0-cpu-v1",
    "claimStatus": "scope-only",
    "baseline": {
      "nativeLockPath": "native/versions.lock.yaml",
      "nativeLockSha256": "ea0f101c6c901287ef498a3f4b04c0fb9d5e3abd20c8fa796534b8f7e141658b",
      "sherpaPubspecLockPath": "templates/android/sherpa_reference_app/pubspec.lock",
      "sherpaPubspecLockSha256": "46e348c45c3b5fa7db647f89eb5bdd16aed3cfc15ac61704aca52b423c50bb4a",
      "packageName": "fonix",
      "packageVersion": "0.1.0-dev.1",
      "shimAbi": 1,
      "requiredOrtApi": 27
    },
    "targets": [
      {
        "os": "ios",
        "architecture": "arm64",
        "variant": "device",
        "flavor": "cpu",
        "minimumOs": "15.1",
        "disposition": "selected",
        "compositions": [
          {
            "id": "ios-arm64-device-cpu-linked",
            "kind": "locked-artifact",
            "artifactId": "onnxruntime-1.27.1-ios-arm64-device-cpu",
            "runtimeOwner": "wrapper",
            "runtimeMode": "linked",
            "advertisedProviders": [
              { "id": "cpu", "requirement": "full-assignment" }
            ]
          }
        ]
      },
      {
        "os": "ios",
        "architecture": "arm64",
        "variant": "simulator",
        "flavor": "cpu",
        "minimumOs": "15.1",
        "disposition": "unsupported",
        "reason": "Simulator execution is development-only and does not qualify an iOS distribution target."
      },
      {
        "os": "ios",
        "architecture": "x86_64",
        "variant": "simulator",
        "flavor": "cpu",
        "minimumOs": "15.1",
        "disposition": "unsupported",
        "reason": "The x86_64 simulator tuple is development-only and lacks installed-simulator execution and distribution qualification."
      },
      {
        "os": "macos",
        "architecture": "arm64",
        "variant": "default",
        "flavor": "cpu",
        "minimumOs": "14.0",
        "disposition": "selected",
        "compositions": [
          {
            "id": "macos-arm64-default-cpu-bundled",
            "kind": "locked-artifact",
            "artifactId": "onnxruntime-1.27.1-macos-arm64-cpu",
            "runtimeOwner": "wrapper",
            "runtimeMode": "bundled",
            "advertisedProviders": [
              { "id": "cpu", "requirement": "full-assignment" }
            ]
          }
        ]
      },
      {
        "os": "android",
        "architecture": "arm64-v8a",
        "variant": "default",
        "flavor": "cpu",
        "minimumOs": "24",
        "disposition": "selected",
        "compositions": [
          {
            "id": "android-arm64-v8a-default-cpu-bundled",
            "kind": "locked-artifact",
            "artifactId": "onnxruntime-1.27.1-android-arm64-v8a-cpu",
            "runtimeOwner": "wrapper",
            "runtimeMode": "bundled",
            "advertisedProviders": [
              { "id": "cpu", "requirement": "full-assignment" }
            ]
          },
          {
            "id": "android-arm64-v8a-default-cpu-sherpa-process",
            "kind": "android-sherpa-process",
            "artifactId": null,
            "runtimeOwner": "sherpa",
            "runtimeMode": "process",
            "advertisedProviders": [
              { "id": "cpu", "requirement": "full-assignment" }
            ],
            "runtimeIdentity": {
              "ownerPackage": "sherpa_onnx",
              "ownerPackageVersion": "1.13.4",
              "onnxRuntimeVersion": "1.27.0"
            }
          }
        ]
      },
      {
        "os": "android",
        "architecture": "x86_64",
        "variant": "default",
        "flavor": "cpu",
        "minimumOs": "24",
        "disposition": "unsupported",
        "reason": "Target execution and final-package evidence are unavailable for Android x86_64."
      },
      {
        "os": "linux",
        "architecture": "x86_64",
        "variant": "default",
        "flavor": "cpu",
        "minimumOs": "glibc-2.27",
        "disposition": "selected",
        "compositions": [
          {
            "id": "linux-x86_64-default-cpu-bundled",
            "kind": "locked-artifact",
            "artifactId": "onnxruntime-1.27.1-linux-x86_64-cpu",
            "runtimeOwner": "wrapper",
            "runtimeMode": "bundled",
            "advertisedProviders": [
              { "id": "cpu", "requirement": "full-assignment" }
            ]
          }
        ]
      },
      {
        "os": "linux",
        "architecture": "arm64",
        "variant": "default",
        "flavor": "cpu",
        "minimumOs": "glibc-2.27",
        "disposition": "unsupported",
        "reason": "Target-host execution and final-package evidence are unavailable for Linux arm64."
      },
      {
        "os": "windows",
        "architecture": "x64",
        "variant": "default",
        "flavor": "cpu",
        "minimumOs": "10.0",
        "disposition": "unsupported",
        "reason": "Windows target-host, provider, final-package, installer, and clean-machine qualification is deferred."
      }
    ],
    "deferredCapabilities": [
      {
        "id": "android-qnn",
        "disposition": "unsupported",
        "reason": "Android QNN qualification is deferred until the exact SDK, hardware, firmware, licensing, redistribution, and target-execution inputs exist."
      },
      {
        "id": "windows-target-host-provider-final-package-installer-clean-machine",
        "disposition": "unsupported",
        "reason": "Windows target-host, provider, final-package, installer, and clean-machine qualification is deferred."
      }
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "claimStatus",
    "baseline",
    "targets",
    "deferredCapabilities"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": { "const": "scoped-pre-1.0-cpu-v1" },
    "claimStatus": { "const": "scope-only" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "targets": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        { "$ref": "#/$defs/iosDeviceTarget" },
        { "$ref": "#/$defs/iosArm64SimulatorTarget" },
        { "$ref": "#/$defs/iosX64SimulatorTarget" },
        { "$ref": "#/$defs/macosArm64Target" },
        { "$ref": "#/$defs/androidArm64Target" },
        { "$ref": "#/$defs/androidX64Target" },
        { "$ref": "#/$defs/linuxX64Target" },
        { "$ref": "#/$defs/linuxArm64Target" },
        { "$ref": "#/$defs/windowsX64Target" }
      ],
      "items": false
    },
    "deferredCapabilities": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/deferredCapability" },
            { "properties": { "id": { "const": "android-qnn" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/deferredCapability" },
            {
              "properties": {
                "id": {
                  "const": "windows-target-host-provider-final-package-installer-clean-machine"
                }
              }
            }
          ]
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000]+$",
      "maxLength": 1024
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeLockPath",
        "nativeLockSha256",
        "sherpaPubspecLockPath",
        "sherpaPubspecLockSha256",
        "packageName",
        "packageVersion",
        "shimAbi",
        "requiredOrtApi"
      ],
      "properties": {
        "nativeLockPath": {
          "allOf": [
            { "$ref": "#/$defs/relativePath" },
            { "const": "native/versions.lock.yaml" }
          ]
        },
        "nativeLockSha256": { "$ref": "#/$defs/sha256" },
        "sherpaPubspecLockPath": {
          "allOf": [
            { "$ref": "#/$defs/relativePath" },
            { "const": "templates/android/sherpa_reference_app/pubspec.lock" }
          ]
        },
        "sherpaPubspecLockSha256": { "$ref": "#/$defs/sha256" },
        "packageName": { "const": "fonix" },
        "packageVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "shimAbi": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "requiredOrtApi": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "providerClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement"],
      "properties": {
        "id": { "const": "cpu" },
        "requirement": { "const": "full-assignment" }
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerPackage",
        "ownerPackageVersion",
        "onnxRuntimeVersion"
      ],
      "properties": {
        "ownerPackage": { "const": "sherpa_onnx" },
        "ownerPackageVersion": { "const": "1.13.4" },
        "onnxRuntimeVersion": { "const": "1.27.0" }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "artifactId",
        "runtimeOwner",
        "runtimeMode",
        "advertisedProviders"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "kind": {
          "enum": ["locked-artifact", "android-sherpa-process"]
        },
        "artifactId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9._-]{0,255}$"
        },
        "runtimeOwner": { "enum": ["wrapper", "sherpa"] },
        "runtimeMode": { "enum": ["linked", "bundled", "process"] },
        "advertisedProviders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "$ref": "#/$defs/providerClaim" }],
          "items": false
        },
        "runtimeIdentity": { "$ref": "#/$defs/runtimeIdentity" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "locked-artifact" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "artifactId": { "type": "string" },
              "runtimeOwner": { "const": "wrapper" },
              "runtimeMode": { "enum": ["linked", "bundled"] }
            },
            "not": { "required": ["runtimeIdentity"] }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "android-sherpa-process" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["runtimeIdentity"],
            "properties": {
              "artifactId": { "const": null },
              "runtimeOwner": { "const": "sherpa" },
              "runtimeMode": { "const": "process" }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "variant",
        "flavor",
        "minimumOs",
        "disposition"
      ],
      "properties": {
        "os": { "enum": ["ios", "macos", "android", "linux", "windows"] },
        "architecture": { "enum": ["arm64", "arm64-v8a", "x86_64", "x64"] },
        "variant": { "enum": ["device", "simulator", "default"] },
        "flavor": { "const": "cpu" },
        "minimumOs": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "disposition": { "enum": ["selected", "unsupported"] },
        "compositions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/composition" }
        },
        "reason": { "$ref": "#/$defs/reason" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "selected" } },
            "required": ["disposition"]
          },
          "then": {
            "required": ["compositions"],
            "not": { "required": ["reason"] }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "unsupported" } },
            "required": ["disposition"]
          },
          "then": {
            "required": ["reason"],
            "not": { "required": ["compositions"] }
          }
        }
      ]
    },
    "iosDeviceTarget": {
      "allOf": [
        { "$ref": "#/$defs/target" },
        {
          "properties": {
            "os": { "const": "ios" },
            "architecture": { "const": "arm64" },
            "variant": { "const": "device" },
            "flavor": { "const": "cpu" },
            "minimumOs": { "const": "15.1" }
          }
        }
      ]
    },
    "iosArm64SimulatorTarget": {
      "allOf": [
        { "$ref": "#/$defs/target" },
        {
          "properties": {
            "os": { "const": "ios" },
            "architecture": { "const": "arm64" },
            "variant": { "const": "simulator" },
            "flavor": { "const": "cpu" },
            "minimumOs": { "const": "15.1" }
          }
        }
      ]
    },
    "iosX64SimulatorTarget": {
      "allOf": [
        { "$ref": "#/$defs/target" },
        {
          "properties": {
            "os": { "const": "ios" },
            "architecture": { "const": "x86_64" },
            "variant": { "const": "simulator" },
            "flavor": { "const": "cpu" },
            "minimumOs": { "const": "15.1" }
          }
        }
      ]
    },
    "macosArm64Target": {
      "allOf": [
        { "$ref": "#/$defs/target" },
        {
          "properties": {
            "os": { "const": "macos" },
            "architecture": { "const": "arm64" },
            "variant": { "const": "default" },
            "flavor": { "const": "cpu" },
            "minimumOs": { "const": "14.0" }
          }
        }
      ]
    },
    "androidArm64Target": {
      "allOf": [
        { "$ref": "#/$defs/target" },
        {
          "properties": {
            "os": { "const": "android" },
            "architecture": { "const": "arm64-v8a" },
            "variant": { "const": "default" },
            "flavor": { "const": "cpu" },
            "minimumOs": { "const": "24" }
          }
        }
      ]
    },
    "androidX64Target": {
      "allOf": [
        { "$ref": "#/$defs/target" },
        {
          "properties": {
            "os": { "const": "android" },
            "architecture": { "const": "x86_64" },
            "variant": { "const": "default" },
            "flavor": { "const": "cpu" },
            "minimumOs": { "const": "24" }
          }
        }
      ]
    },
    "linuxX64Target": {
      "allOf": [
        { "$ref": "#/$defs/target" },
        {
          "properties": {
            "os": { "const": "linux" },
            "architecture": { "const": "x86_64" },
            "variant": { "const": "default" },
            "flavor": { "const": "cpu" },
            "minimumOs": { "const": "glibc-2.27" }
          }
        }
      ]
    },
    "linuxArm64Target": {
      "allOf": [
        { "$ref": "#/$defs/target" },
        {
          "properties": {
            "os": { "const": "linux" },
            "architecture": { "const": "arm64" },
            "variant": { "const": "default" },
            "flavor": { "const": "cpu" },
            "minimumOs": { "const": "glibc-2.27" }
          }
        }
      ]
    },
    "windowsX64Target": {
      "allOf": [
        { "$ref": "#/$defs/target" },
        {
          "properties": {
            "os": { "const": "windows" },
            "architecture": { "const": "x64" },
            "variant": { "const": "default" },
            "flavor": { "const": "cpu" },
            "minimumOs": { "const": "10.0" }
          }
        }
      ]
    },
    "deferredCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "disposition", "reason"],
      "properties": {
        "id": {
          "enum": [
            "android-qnn",
            "windows-target-host-provider-final-package-installer-clean-machine"
          ]
        },
        "disposition": { "const": "unsupported" },
        "reason": { "$ref": "#/$defs/reason" }
      }
    }
  }
}
