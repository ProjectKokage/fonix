{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fonix.invalid/schemas/provider-assignment-evidence-v1.json",
  "title": "Fonix normalized provider assignment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "nodeExecutionCount",
    "nodeExecutionsByProvider"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "nodeExecutionCount": { "$ref": "#/$defs/nodeCount" },
    "nodeExecutionsByProvider": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
      },
      "additionalProperties": { "$ref": "#/$defs/nodeCount" }
    }
  },
  "$defs": {
    "nodeCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  }
}
