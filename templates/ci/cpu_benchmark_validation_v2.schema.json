{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fonix.invalid/schemas/cpu-benchmark-validation-v2.json",
  "title": "Fonix CPU benchmark raw-bundle offline validation record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "result",
    "claimStatus",
    "purpose",
    "validationScope",
    "rawEvidenceRequiredForEvaluation",
    "bundle",
    "collection",
    "tools",
    "schemas",
    "source",
    "artifacts",
    "recordedTarget",
    "claimBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "result": { "const": "validated" },
    "claimStatus": { "const": "measurement-only" },
    "purpose": { "const": "cpu-benchmark-raw-bundle-offline-validation" },
    "validationScope": { "const": "offline-consistency-only" },
    "rawEvidenceRequiredForEvaluation": { "const": true },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "fileCount", "byteCount", "sha256", "files"],
      "properties": {
        "format": { "const": "fonix-cpu-benchmark-raw-bundle-v1" },
        "fileCount": { "const": 7 },
        "byteCount": {
          "type": "integer",
          "minimum": 7,
          "maximum": 10092544
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "$ref": "#/$defs/bundleFile",
              "properties": {
                "name": { "const": "cpu-benchmark-collection.json" },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8388608
                }
              }
            },
            {
              "$ref": "#/$defs/bundleFile",
              "properties": {
                "name": { "const": "fragment-00.json" },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 131072
                }
              }
            },
            {
              "$ref": "#/$defs/bundleFile",
              "properties": {
                "name": { "const": "fragment-01.json" },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 131072
                }
              }
            },
            {
              "$ref": "#/$defs/bundleFile",
              "properties": {
                "name": { "const": "fragment-02.json" },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 131072
                }
              }
            },
            {
              "$ref": "#/$defs/bundleFile",
              "properties": {
                "name": { "const": "fragment-03.json" },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 131072
                }
              }
            },
            {
              "$ref": "#/$defs/bundleFile",
              "properties": {
                "name": { "const": "fragment-04.json" },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 131072
                }
              }
            },
            {
              "$ref": "#/$defs/bundleFile",
              "properties": {
                "name": { "const": "host-observations.json" },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1048576
                }
              }
            }
          ]
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeBytes", "sha256", "launchCount", "collectorSha256"],
      "properties": {
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "launchCount": { "const": 5 },
        "collectorSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector", "collectionCore", "validator"],
      "properties": {
        "collector": { "$ref": "#/$defs/fileIdentity" },
        "collectionCore": { "$ref": "#/$defs/fileIdentity" },
        "validator": { "$ref": "#/$defs/fileIdentity" }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetFragmentV2",
        "targetFragment",
        "collectionV2",
        "collection",
        "validation"
      ],
      "properties": {
        "targetFragmentV2": { "$ref": "#/$defs/fileIdentity" },
        "targetFragment": { "$ref": "#/$defs/fileIdentity" },
        "collectionV2": { "$ref": "#/$defs/fileIdentity" },
        "collection": { "$ref": "#/$defs/fileIdentity" },
        "validation": { "$ref": "#/$defs/fileIdentity" }
      }
    },
    "source": {
      "$ref": "https://fonix.invalid/schemas/cpu-benchmark-collection-v3.json#/$defs/repositoryEvidence"
    },
    "artifacts": {
      "$ref": "https://fonix.invalid/schemas/cpu-benchmark-collection-v3.json#/$defs/artifacts"
    },
    "recordedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceSource",
        "authenticationStatus",
        "hostObservationSha256",
        "platform",
        "architecture",
        "deviceIdentitySha256",
        "osVersion",
        "osBuild",
        "driverIdentity",
        "firmwareIdentity"
      ],
      "properties": {
        "evidenceSource": {
          "const": "checked-host-observation-sidecar"
        },
        "authenticationStatus": {
          "const": "not-independently-authenticated"
        },
        "hostObservationSha256": { "$ref": "#/$defs/sha256" },
        "platform": { "enum": ["macos", "linux"] },
        "architecture": { "enum": ["arm64", "x86_64"] },
        "deviceIdentitySha256": { "$ref": "#/$defs/sha256" },
        "osVersion": {
          "$ref": "https://fonix.invalid/schemas/cpu-benchmark-collection-v3.json#/$defs/label"
        },
        "osBuild": {
          "$ref": "https://fonix.invalid/schemas/cpu-benchmark-collection-v3.json#/$defs/label"
        },
        "driverIdentity": {
          "$ref": "https://fonix.invalid/schemas/cpu-benchmark-collection-v3.json#/$defs/label"
        },
        "firmwareIdentity": {
          "$ref": "https://fonix.invalid/schemas/cpu-benchmark-collection-v3.json#/$defs/label"
        }
      }
    },
    "claimBoundary": {
      "const": "Offline consistency validation of one exact raw CPU measurement bundle only. The raw bundle must be retained and independently reopened for every later evaluation. Raw fragments and recorded host observations are checked for internal consistency but are not independently authenticated; process freshness is not independently attested. This record is not a performance baseline, regression threshold, provider qualification, platform support claim, release approval, or cross-target evidence."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeBytes", "sha256"],
      "properties": {
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bundleFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sizeBytes", "sha256"],
      "properties": {
        "name": {
          "enum": [
            "cpu-benchmark-collection.json",
            "fragment-00.json",
            "fragment-01.json",
            "fragment-02.json",
            "fragment-03.json",
            "fragment-04.json",
            "host-observations.json"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
